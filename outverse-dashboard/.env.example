# Public Django API (HTTPS in production — enables WSS for chat)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional — force Emotion Vault demo data when API is empty
# NEXT_PUBLIC_VAULT_DEMO=true

# Optional — Cloudflare Turnstile site key for bot protection on signup.
# Unset → the widget doesn't render and registration proceeds without it
# (matches the backend, which also skips verification when unconfigured).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
