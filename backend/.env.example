# Django + Whisper settings 
# Django — copy to .env or set in your host environment
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins when DEBUG=False
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional — WebSocket chat scaling
# REDIS_URL=redis://127.0.0.1:6379/0

# Optional — legacy chat user id header (default false)
# CHAT_ALLOW_LEGACY_USER_ID=false
