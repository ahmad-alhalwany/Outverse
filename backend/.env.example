# Django + Whisper settings 
# Django — copy to .env or set in your host environment
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins when DEBUG=False
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional — WebSocket chat scaling
# REDIS_URL=redis://127.0.0.1:6379/0

# Optional — legacy chat user id header (default false)
# CHAT_ALLOW_LEGACY_USER_ID=false

# Optional — read replica (Postgres). Unset → all reads/writes use primary.
# DATABASE_REPLICA_URL=postgresql://outverse:password@replica-host:5432/outverse

# Optional — S3-compatible media storage (AWS S3, Cloudflare R2, Backblaze B2, ...)
# Unset AWS_STORAGE_BUCKET_NAME → media stays on local disk (dev default).
# For Cloudflare R2: create a bucket + API token in the Cloudflare dashboard, then:
# AWS_STORAGE_BUCKET_NAME=outverse-media
# AWS_ACCESS_KEY_ID=your-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=media.outverse.app
# DJANGO_MEDIA_URL=https://media.outverse.app/
# After setting these, run: python manage.py migrate_media_to_storage

# Optional — real live streaming (Cloudflare Stream Live Inputs).
# Unset → sessions fall back to a local stream key with no rtmp/playback URL
# (camera preview only, exactly like before this feature existed).
# CLOUDFLARE_STREAM_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_STREAM_API_TOKEN=your-stream-api-token
# CLOUDFLARE_STREAM_CUSTOMER_CODE=your-customer-subdomain-code

# Optional — Stripe (Cosmic Pass + coin packs). Empty → checkout returns 503.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# FRONTEND_URL=http://localhost:3000

# Optional — ads pricing overrides
# ADS_CPM_RATE=5.0
# ADS_CPC_RATE=0.50

# Optional — real outbound email (digests + marketing campaigns).
# Unset → EMAIL_BACKEND defaults to the console backend (prints instead of sending).
# Self-hosted SMTP has poor deliverability for bulk/marketing mail — prefer an ESP's
# SMTP relay (SendGrid, Postmark, Resend, etc.), which handles SPF/DKIM/bounces for you.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-esp-smtp-api-key
# EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@outverse.app

# Optional — Google Sign-In (must match web/mobile client IDs)
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional — Apple Sign-In (must match web/mobile client IDs; a Service ID
# from the Apple Developer "Sign in with Apple" setup)
# APPLE_CLIENT_ID=com.outverse.app.web

# Optional — TURN server for WebRTC calls (comma-separated URLs sharing the
# same credentials, e.g. UDP/TCP/TLS variants). Without it, calls fall back
# to STUN-only, which fails for some users behind strict NATs/firewalls.
# TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=your-turn-username
# TURN_PASSWORD=your-turn-password

# Optional — CDN URL for serving media and static files (no trailing slash).
# When set, MEDIA_URL and STATIC_URL are overridden to point to the CDN.
# CDN_URL=https://cdn.outverse.app

# Optional — Postgres read replica. Unset → all traffic uses primary.
# DATABASE_REPLICA_URL=postgresql://outverse:password@replica-host:5432/outverse

# Optional — public frontend URL (used for email links etc.)
# FRONTEND_URL=https://outverse.app

# Optional — AI providers (daily Lab challenge + inspiration)
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional — Docker cron schedule (UTC)
# CRON_DAILY_CHALLENGE_HOUR=6
# CRON_DAILY_CHALLENGE_MINUTE=0
# CRON_DAILY_CHALLENGE_LANG=en
# CRON_DIGEST_HOUR=8
# CRON_DIGEST_MINUTE=0
