{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "isolatedModules": true,
    "module": "esnext",
    "target": "ESNext",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/api/*": [
        "src/api/*"
      ],
      "@/store/*": [
        "src/store/*"
      ],
      "@/components/*": [
        "src/components/*"
      ],
      "@/hooks/*": [
        "src/hooks/*"
      ],
      "@/utils/*": [
        "src/utils/*"
      ],
      "@/types/*": [
        "src/types/*"
      ],
      "@/screens/*": [
        "src/screens/*"
      ],
      "react-native-webrtc": [
        "src/shims/react-native-webrtc.d.ts"
      ]
    },
    "skipLibCheck": true,
    "moduleSuffixes": [".native", ""]
  },
  "include": [
    "src/**/*",
    "app/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/shims/react-native-webrtc.native.js"
  ],
  "extends": "expo/tsconfig.base"
}
