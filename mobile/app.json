{
  "name": "Cosonova",
  "slug": "cosonova-mobile",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "automatic",
  "newArchEnabled": true,
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#0A0A0F"
  },
  "assetBundlePatterns": [
    "**/*"
  ],
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.cosonova.mobile",
    "buildNumber": "1",
    "infoPlist": {
      "NSCameraUsageDescription": "Cosonova uses the camera for posts, stories, and video calls.",
      "NSPhotoLibraryUsageDescription": "This app accesses photo library for media uploads",
      "NSMicrophoneUsageDescription": "Cosonova uses the microphone for recording and calls.",
      "NSLocationWhenInUseUsageDescription": "Cosonova uses your location to center the Story Map and show nearby pins."
    }
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#0A0A0F"
    },
    "package": "com.cosonova.mobile",
    "versionCode": 1,
    "permissions": [
      "CAMERA",
      "READ_EXTERNAL_STORAGE",
      "WRITE_EXTERNAL_STORAGE",
      "RECORD_AUDIO",
      "INTERNET",
      "ACCESS_COARSE_LOCATION",
      "ACCESS_FINE_LOCATION"
    ]
  },
  "web": {
    "favicon": "./assets/favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    "expo-secure-store",
    "expo-image-picker",
    [
      "expo-splash-screen",
      {
        "image": "./assets/splash.png",
        "backgroundColor": "#0A0A0F"
      }
    ],
    "expo-font",
    "./plugins/withWebRTC.js"
  ],
  "scheme": "cosonova",
  "extra": {
    "eas": {
      "projectId": "2e864d9c-f2e9-4b39-b682-99569d18291c"
    },
    "apiUrl": "https://98-81-52-33.nip.io/api",
    "googleClientId": "121583227503-h1iblf9850a69djgn7m53l7afpbmcva0.apps.googleusercontent.com",
    "appleClientId": ""
  },
  "owner": "ahmad_alhalwany"
}
