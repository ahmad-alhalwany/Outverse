# Outverse — local docker-compose secrets. Copy to .env and fill in.
# DO NOT commit the real .env file.

POSTGRES_DB=outverse
POSTGRES_USER=outverse
POSTGRES_PASSWORD=change-me-to-a-real-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key

# Optional — enables LLM-powered features (Inspiration Engine, Writing Buddy, Room Recap summaries)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — error tracking
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional — Google Sign-In (OAuth client ID from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
# Web GIS (Next.js) — usually the same Web client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Mobile Expo — same Web client ID works for id_token flow if redirect URI is allowed
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Apple Sign-In (Services ID / Bundle ID used as aud in identity token)
APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
EXPO_PUBLIC_APPLE_CLIENT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@outverse.local

# Stripe (Cosmic Pass + coin packs). Empty → checkout disabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# Cloudflare Stream Live Inputs (real RTMP/WHIP + HLS)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# Ads pricing overrides (USD)
ADS_CPM_RATE=5.0
ADS_CPC_RATE=0.50

# Multi-region / CDN
# Set to your CDN base URL (no trailing slash) to serve media and static files via CDN.
# Unset → files served from local nginx paths /media/ and /static/.
CDN_URL=

# Production replica DB (Postgres read replica). Unset → all reads use primary.
DATABASE_REPLICA_URL=
